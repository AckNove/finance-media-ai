# ============================================================
# finance-media-ai 环境变量示例
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 排除，绝不提交。
#      copy .env.example .env
# ============================================================

# --- 运行环境 ---
# development | test | production
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# --- 数据库 ---
# 第一阶段：SQLite 本地文件库（相对项目根目录）
DATABASE_URL=sqlite:///./data/finance_media.db
# 后续迁移 PostgreSQL 时替换为（示例，勿在此填写真实密码）：
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/finance_media

# --- API 服务 ---
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api

# ============================================================
# 以下为未来阶段的第三方接入占位。
# 第一阶段不接入任何真实模型/搜索服务，请保持为空，勿提交真实密钥。
# ============================================================
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# SEARCH_API_KEY=
