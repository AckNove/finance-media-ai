# ============================================================
# finance-media-ai .gitignore
# 原则：密钥、数据库文件、媒体大文件、虚拟环境一律不入库。
# ============================================================

# --- 密钥与环境变量（绝不提交） ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
.Python
build/
dist/
*.egg-info/
.eggs/

# --- 测试与静态检查缓存 ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- 数据库（本地 SQLite 不入库） ---
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite*

# --- 运行时日志 ---
*.log
logs/

# --- 媒体与素材大文件（保留目录占位） ---
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.psd
*.aep
content/assets/**
video_engine/render_tmp/**
!**/.gitkeep

# --- 数据目录内容（保留目录占位） ---
data/raw/**
data/processed/**
data/exports/**
!**/.gitkeep

# --- 编辑器与系统 ---
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 其他 ---
*.tmp
*.bak
