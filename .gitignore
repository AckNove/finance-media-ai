# ============================================================
# finance-media-ai .gitignore
# 原则：密钥、数据库文件、媒体大文件、虚拟环境一律不入库。
# ============================================================

# --- 密钥与环境变量（绝不提交） ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
.Python
build/
dist/
*.egg-info/
.eggs/

# --- 测试与静态检查缓存 ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- 数据库（本地 SQLite 不入库） ---
*.db
*.db-journal
# WAL 模式会额外产生 -wal / -shm 文件（M2.0 起开启），同样不入库
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite*

# --- 数据库备份（本地生成，含真实数据，不入库） ---
data/backups/**
!data/backups/.gitkeep

# --- 运行时日志 ---
*.log
logs/

# --- 媒体与素材大文件（保留目录占位） ---
*.mp4
# 例外：第一条作品的成片是"这条片子到底长什么样"的唯一证据，用户要求入库，
# 方便直接在网页上看。其余 *.mp4 仍然不进库（可再生、且容易把库撑大）。
!content/jobs/v6_power_first_film/output/final.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.psd
*.aep
content/assets/**
# 曲库的登记表与说明要入库（音频文件本身仍然忽略，见上面的 *.mp3/*.wav）
!content/assets/bgm/
!content/assets/bgm/README.md
!content/assets/bgm/library.yaml
video_engine/render_tmp/**
# 导出包（content/exports/<排期号>/<时间戳>/）是交付物：文案、README、清单都是生成的，
# 里面还有 film/final.mp4——硬链接在 git 眼里同样是完整 blob，一次 git add -A 就能把
# 几 MB 视频提交进去。它们在磁盘上照旧存在，要发的时候直接打开目录拿。
content/exports/
!**/.gitkeep

# --- 数据目录内容（保留目录占位） ---
data/raw/**
data/processed/**
data/exports/**
!**/.gitkeep

# --- 编辑器与系统 ---
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 其他 ---
*.tmp
*.bak

# --- 项目独立工具链（V2.2 Phase 1）---
# 第三方二进制与运行期目录不入库；只保留来源、版本与许可证记录。
# tools/openkatana 的 projects/ 全是渲染产物与技能副本，同样不入库。
tools/_staging/
tools/ffmpeg/bin/
tools/ffmpeg/doc/
tools/ffmpeg/presets/
tools/openkatana/.venv/
tools/openkatana/projects/
tools/openkatana/**/node_modules/
!tools/ffmpeg/VERSION.json
!tools/ffmpeg/SOURCE.md
!tools/ffmpeg/LICENSE
# tools/openkatana 是固定 commit 的第三方仓库克隆（自带 .git）。
# 直接 add 会变成没有 .gitmodules 的坏 gitlink，所以整目录不入库；
# 版本与 commit 记录在 backend/app/capabilities/media/openkatana.py 与
# docs/research_hub/video_pipeline_v2_1_report.md，可用 git clone + scripts/setup.py 复现。
tools/openkatana/

# --- 内容任务目录（V2.1 / V2.2）---
# 渲染中间产物（帧序列、素材盘、字体副本）全部可再生，体积却以 GB 计，不入库。
# 保留：storyboard/、script/、research/、project/**/timeline.json、
#       assets/compositions/*.json、qc/*.md|json、assets_manifest.csv。
content/jobs/*/project/*/.openkatana/
content/jobs/*/project/*/plates/
content/jobs/*/project/*/media/
content/jobs/*/project/*/fonts/
content/jobs/*/project/*/history/
content/jobs/*/project/.openkatana_io/
content/jobs/assets/frames/
content/jobs/media_toolchain_check/work/
content/jobs/media_toolchain_check/audio/
content/jobs/media_toolchain_check/output/
# 引擎每次保存时间轴留下的历史快照（timeline-<hash>.json）同样可再生，不入库。
content/jobs/*/project/*/timeline-*.json
# 渲染流水线在引擎工程目录里生成的副本：组合文档被引擎重存后的 assets/，
# 以及"project/timeline.json 已存在且内容不同"时另存的时间轴。都是产物，不入库。
content/jobs/*/project/*/assets/
content/jobs/*/project/timeline.render.json
# 任务目录里的字体副本（17 MB，源自系统字体）、引擎调用参数与旁白音频都是可再生的中间产物。
content/jobs/*/fonts/
content/jobs/*/.openkatana_io/
content/jobs/*/audio/narration/*.mp3
content/jobs/*/audio/narration/*.wav
# 成片改由本地保留：Phase 2 冻结轮按"不把 MP4 等大体积可再生资产提交到 Git"的口径，
# 取消了原先的 !content/jobs/*/output/*.mp4 例外。文件仍在磁盘上，路径与 SHA-256 记在
# docs/research_hub/phase2_artifact_index.md。需要重新入库时删除本节注释并 git add -f 即可。

# V1 旧任务目录：含从本机桌面复制来的原始数据（csv/xlsx/pdf），
# 与 V2.x 的「旧数据全局隔离」口径一致，不入库。本地文件保留在磁盘上。
content/jobs/20261110_jgb_gold_repricing/

# 抓取快照（data/snapshots/<host>/<sha256>.html）：是"当时页面长什么样"的证据，
# 但内容是第三方原文，体积也大，不入库；结论与 SHA-256 记在数据库与输出 JSON 里。
data/snapshots/

# 重制片（remaster_v1）：工程、蓝图、评分、成片入库；逐帧图与分段视频可再生、不入库
content/jobs/*/remaster_v1/production/frames/
content/jobs/*/remaster_v1/production/scenes_video/
content/jobs/*/remaster_v1/assets/audio/*.wav
!content/jobs/v6_power_first_film/remaster_v1/output/final.mp4
!content/jobs/v6_power_first_film/remaster_v1/output/prototype_15_20s.mp4
# 镜头目录里的字体是每镜一份拷贝（17 MB/个），由 --stage scenes 自动复制，不入库
content/jobs/*/remaster_v1/production/scenes/*/fonts/

# V2 重制：镜头页里的字体拷贝（每镜 17 MB，源字体在 content/jobs/*/fonts/）、渲染帧与逐镜视频
content/jobs/*/remaster_v2/production/scenes/*/fonts/
content/jobs/*/remaster_v2/production/frames/
content/jobs/*/remaster_v2/production/scenes_video/
content/jobs/*/remaster_v2/assets/audio/*.wav

# V2 真实素材：允许入库的实拍原图（授权已逐项登记，见 source_register.csv）
!content/jobs/v6_power_first_film/remaster_v2/assets/real/_staging/*.jpg
content/jobs/*/remaster_v2/production/clips/
content/jobs/*/remaster_v2/output/prototype.ass
content/jobs/*/remaster_v2/output/prototype_concat.txt
!content/jobs/v6_power_first_film/remaster_v2/output/prototype_15_20s.mp4

# V2 重制：源视频与派生片段不入库（体积大、可用 acquire_real_videos.py 复现）
content/jobs/*/remaster_v2/assets/real/_staging_video/
content/jobs/*/remaster_v2/production/scenes/*/clip.mp4
content/jobs/*/remaster_v2/production/clips/
!content/jobs/v6_power_first_film/remaster_v2/output/prototype_15_20s.mp4

content/jobs/*/v2auto/frames/
content/jobs/*/v2auto/clips/
content/jobs/*/v2auto/media/
content/jobs/*/v2auto/audio/*.wav

content/jobs/*/v2auto/scenes/*/fonts/
content/jobs/*/v2auto/scenes/*/clip.mp4
content/jobs/*/v2auto/scenes/*/photo.jpg

!content/jobs/v6_power_first_film/v2auto/output/final.mp4

# V2.0 自动装配的中间产物（片段、帧序列、音频中间件，都可再生）
content/jobs/*/v2auto/frames/
content/jobs/*/v2auto/clips/
content/jobs/*/v2auto/media/
content/jobs/*/v2auto/audio/*.wav
content/jobs/*/v2auto/scenes/*/fonts/
content/jobs/*/v2auto/scenes/*/clip.mp4
content/jobs/*/v2auto/scenes/*/photo.jpg
!content/jobs/v6_power_first_film/v2auto/output/final.mp4
# 真人录音与按录音重排的中间产物（原件在用户机器上，中间件可再生）
content/jobs/*/voiceover/raw/
content/jobs/*/voiceover/clean/
content/jobs/*/voiceover/pieces/
content/jobs/*/voiceover/*.wav
content/jobs/*/voiceover/transcript.json
content/jobs/*/v2vo/frames/
content/jobs/*/v2vo/clips/
content/jobs/*/v2vo/media/
content/jobs/*/v2vo/audio/*.wav
content/jobs/*/v2vo/scenes/*/fonts/
content/jobs/*/v2vo/scenes/*/clip.mp4
content/jobs/*/v2vo/scenes/*/photo.jpg
content/jobs/*/v2vo/output/*.mp4
